<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Non-Operating Owners · Maritime Investment</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#080c18;--text:#f1f5f9;--muted:#475569;--gold:#f59e0b;--green:#4ade80;--red:#f87171;--slate:#38bdf8;--purple:#a78bfa;--border:rgba(255,255,255,0.07);--size:min(100vw,100vh)}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:#000;height:100vh;width:100vw;overflow:hidden;font-family:"DM Sans",sans-serif;color:var(--text);display:flex;align-items:center;justify-content:center}

/* ── Square deck: always 1:1, fills the smaller axis ── */
.deck-wrap{width:var(--size);height:var(--size);position:relative;background:var(--bg);overflow:hidden;flex-shrink:0}
.deck{width:100%;height:100%;position:relative}

.slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(.97);transition:opacity .45s ease,transform .45s ease;pointer-events:none;overflow:hidden}
.slide.active{opacity:1;transform:scale(1);pointer-events:all}
.content{position:relative;z-index:2;width:100%;max-width:100%;padding:clamp(1.4rem,3.5vw,3rem)}
.reveal{opacity:0;transform:translateY(14px)}
.blob{position:absolute;border-radius:50%;filter:blur(90px);animation:float-slow 14s ease-in-out infinite}
@keyframes float-slow{0%,100%{transform:translate(0,0)}50%{transform:translate(40px,-35px)}}

/* ── Nav ── */
.nav-controls{position:absolute;bottom:18px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:12px;z-index:200;background:rgba(255,255,255,.04);backdrop-filter:blur(12px);padding:7px 18px;border-radius:40px;border:1px solid rgba(255,255,255,.08)}
.nav-btn{width:30px;height:30px;border:none;background:rgba(255,255,255,.06);color:var(--slate);border-radius:50%;font-size:1rem;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.nav-btn:hover{background:rgba(255,255,255,.12)}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.12);cursor:pointer;transition:all .3s}.dot.active{background:var(--slate);transform:scale(1.4)}
.slide-counter{font-size:.62rem;color:var(--muted);min-width:28px;text-align:center}
.author-tag{position:absolute;bottom:18px;right:22px;z-index:300;font-size:.58rem;font-weight:600;letter-spacing:.05em;color:rgba(148,163,184,.3);pointer-events:none}

/* ── Utilities ── */
.label{font-size:.58rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.pill{font-size:.56rem;font-weight:700;padding:2px 7px;border-radius:4px}
.p-pos{background:rgba(74,222,128,.12);color:#4ade80}.p-neg{background:rgba(248,113,113,.12);color:#f87171}
.kicker{display:inline-block;padding:.25rem .65rem;border-radius:999px;font-size:.58rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:.5rem}
.kicker-blue{background:rgba(56,189,248,.08);border:1px solid rgba(56,189,248,.18);color:#38bdf8}
.card{border-radius:12px;padding:1rem 1.1rem;border:1px solid var(--border);background:rgba(255,255,255,.03)}
.card-blue{border-top:2px solid #38bdf8;background:rgba(56,189,248,.04)}
.mini{font-size:.75rem;line-height:1.55;color:#94a3b8}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.three-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.9rem}

/* ── S1 ── */
.s1-stat{text-align:center}
.s1-stat-num{font-size:clamp(1.5rem,3vw,2.2rem);font-weight:900;font-family:"Playfair Display",serif}
.s1-stat-label{font-size:.58rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:.12rem}
.s1-divider{width:1px;background:rgba(255,255,255,.08)}

/* ── S2 ── */
.quote-block{border-left:2px solid var(--slate);padding:.65rem .9rem;background:rgba(56,189,248,.04);border-radius:0 10px 10px 0}
.investor-row{display:flex;gap:.5rem;flex-wrap:wrap;padding-top:.8rem;border-top:1px solid rgba(255,255,255,.06)}
.inv-tag{padding:.28rem .65rem;border-radius:7px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);font-size:.69rem;font-weight:600;color:#cbd5e1}

/* ── S3 flow ── */
.flow-row{display:flex;align-items:center;gap:0;justify-content:center;margin:.65rem 0}
.flow-box{padding:.55rem .9rem;border-radius:9px;border:1px solid var(--border);background:rgba(255,255,255,.04);text-align:center;font-size:.74rem;font-weight:700;flex:1}
.flow-box.highlight{border-color:rgba(56,189,248,.35);background:rgba(56,189,248,.07);color:#38bdf8}
.flow-box.flow-green{border-color:rgba(74,222,128,.3);background:rgba(74,222,128,.06);color:#4ade80}
.flow-arrow{color:var(--muted);font-size:.9rem;padding:0 .3rem;flex-shrink:0}
.attr-row{display:grid;grid-template-columns:1fr 1px 1fr;gap:0;margin-top:.8rem}
.attr-divider{background:rgba(255,255,255,.06)}
.attr-col{padding:.4rem .8rem}
.attr-item{display:flex;gap:.45rem;align-items:flex-start;font-size:.72rem;color:#cbd5e1;line-height:1.5;margin-bottom:.4rem}
.attr-icon{flex-shrink:0;font-size:.76rem;margin-top:.1rem}

/* ── S4 ── */
.reason-card{padding:.8rem .95rem;border-radius:11px;border:1px solid var(--border);background:rgba(255,255,255,.025);display:flex;flex-direction:column;gap:.3rem}
.reason-num{font-size:1.4rem;font-weight:900;font-family:"Playfair Display",serif;color:rgba(56,189,248,.35);line-height:1}
.reason-title{font-size:.8rem;font-weight:700}
.reason-body{font-size:.7rem;color:#94a3b8;line-height:1.5}

/* ── S5 ── */
.balance-grid{display:grid;grid-template-columns:1fr 50px 1fr;gap:0;align-items:start;margin-top:.75rem}
.balance-side{display:flex;flex-direction:column;gap:.5rem}
.balance-center{display:flex;align-items:stretch;justify-content:center}
.bal-item{padding:.65rem .85rem;border-radius:9px;border:1px solid var(--border);font-size:.72rem;line-height:1.5;color:#cbd5e1}
.bal-item-pos-g{border-left:3px solid var(--green);background:rgba(74,222,128,.04)}
.bal-item-pos-b{border-left:3px solid #38bdf8;background:rgba(56,189,248,.04)}
.risk-block{margin-top:.4rem;padding:.7rem .85rem;border-radius:9px;border:1px solid rgba(248,113,113,.18);background:rgba(248,113,113,.04)}
.risk-block-title{font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#f87171;margin-bottom:.4rem}
.risk-line{font-size:.71rem;color:#fca5a5;line-height:1.5;padding:.2rem 0;border-bottom:1px solid rgba(248,113,113,.08)}
.risk-line:last-child{border-bottom:none}
</style>
</head>
<body>
<div class="deck-wrap">
<div class="deck">

<!-- ═══ SLIDE 1 · HOOK ═══ -->
<div class="slide active" data-slide="1">
  <div class="blob" style="width:480px;height:480px;top:-120px;right:-100px;background:#0369a1;opacity:.13"></div>
  <div class="blob" style="width:260px;height:260px;bottom:-80px;left:-60px;background:#1e3a5f;opacity:.09;animation-delay:5s"></div>
  <div class="content" style="text-align:center">
    <div class="reveal" style="display:inline-block;background:rgba(56,189,248,.1);border:1px solid rgba(56,189,248,.2);border-radius:40px;padding:.26rem 1rem;font-size:.66rem;letter-spacing:.13em;text-transform:uppercase;color:#38bdf8;margin-bottom:1.2rem">Maritime Investment · NOO Series</div>
    <h1 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.7rem,4vw,3rem);font-weight:900;line-height:1.12;margin-bottom:.6rem">Most people think shipping companies<br>own their ships.</h1>
    <h1 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.7rem,4vw,3rem);font-weight:900;line-height:1.12;color:#38bdf8;margin-bottom:1.4rem">Most of the time, they don't.</h1>
    <p class="reveal" style="font-size:clamp(.8rem,1.1vw,.92rem);color:#94a3b8;max-width:580px;margin:0 auto 1.8rem;line-height:1.7">Non-Operating Owners control <strong style="color:#f1f5f9">40% of the global fleet by tonnage.</strong> They lease the vessel, collect the income, and never touch the cargo.</p>
    <div class="reveal" style="display:flex;justify-content:center;align-items:center;gap:2.2rem;flex-wrap:wrap">
      <div class="s1-stat"><div class="s1-stat-num" style="color:#f59e0b">40%</div><div class="s1-stat-label">Global fleet by NOOs</div></div>
      <div class="s1-divider" style="height:40px"></div>
      <div class="s1-stat"><div class="s1-stat-num">$2.5bn+</div><div class="s1-stat-label">Seaspan fleet reference</div></div>
      <div class="s1-divider" style="height:40px"></div>
      <div class="s1-stat"><div class="s1-stat-num" style="color:#4ade80">Passive</div><div class="s1-stat-label">Zero operational exposure</div></div>
    </div>
  </div>
</div>

<!-- ═══ SLIDE 2 · WHAT IS A NOO ═══ -->
<div class="slide" data-slide="2">
  <div class="blob" style="width:360px;height:360px;top:-90px;right:-80px;background:#1e3a5f;opacity:.11"></div>
  <div class="blob" style="width:220px;height:220px;bottom:-60px;left:-45px;background:#0369a1;opacity:.08;animation-delay:6s"></div>
  <div class="content">
    <div class="reveal label" style="color:var(--muted);margin-bottom:.28rem">The Model</div>
    <h2 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.35rem,2.6vw,1.9rem);font-weight:700;margin-bottom:.9rem">What is a <span style="color:#38bdf8">Non-Operating Owner?</span></h2>
    <div class="two-col" style="gap:1.1rem;align-items:start">
      <div style="display:flex;flex-direction:column;gap:.8rem">
        <div class="reveal" style="font-size:.9rem;line-height:1.65;color:#e2e8f0">A NOO <strong>buys the vessel, charters it to a carrier, and collects the rent.</strong> No cargo. No crew management. No port calls.</div>
        <div class="reveal quote-block">
          <div style="font-size:.84rem;line-height:1.6;color:#e2e8f0;font-style:italic">"Think of it as maritime real estate. You own the building. Someone else runs the hotel."</div>
        </div>
        <div class="reveal" style="font-size:.78rem;color:#94a3b8;line-height:1.6">The asset, not the operation, is the business. The NOO's return is anchored in the <strong style="color:#f1f5f9">charter rate</strong> and the <strong style="color:#f1f5f9">residual value</strong> of the hull — not in freight markets or cargo volumes.</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:.8rem">
        <div class="reveal card card-blue">
          <div class="label" style="color:#38bdf8;margin-bottom:.4rem">The NOO structure</div>
          <div style="display:flex;flex-direction:column;gap:.38rem">
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:#cbd5e1"><span style="color:#4ade80">→</span> Purchases or finances the vessel</div>
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:#cbd5e1"><span style="color:#4ade80">→</span> Signs a long-term time charter with a carrier</div>
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:#cbd5e1"><span style="color:#4ade80">→</span> Receives fixed daily hire rate</div>
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:#cbd5e1"><span style="color:#4ade80">→</span> Carrier handles crew, fuel, ops</div>
            <div style="display:flex;align-items:center;gap:.5rem;font-size:.76rem;color:#cbd5e1"><span style="color:#4ade80">→</span> NOO retains ownership and residual value</div>
          </div>
        </div>
      </div>
    </div>
    <div class="reveal" style="border-top:1px solid rgba(255,255,255,.06);padding-top:.7rem;margin-top:.1rem">
      <div class="label" style="color:var(--muted);margin-bottom:.45rem">Who are these owners?</div>
      <div style="display:flex;gap:.55rem;flex-wrap:wrap;width:100%">
        <div class="inv-tag" style="flex:1;min-width:110px;text-align:center">Investment funds</div>
        <div class="inv-tag" style="flex:1;min-width:110px;text-align:center">Pension funds</div>
        <div class="inv-tag" style="flex:1;min-width:110px;text-align:center">Infrastructure funds</div>
        <div class="inv-tag" style="flex:1;min-width:160px;text-align:center">Listed platforms </div>
        <div class="inv-tag" style="flex:1;min-width:110px;text-align:center">Private maritime families</div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ SLIDE 3 · INVESTMENT CASE ═══ -->
<div class="slide" data-slide="3">
  <div class="blob" style="width:340px;height:340px;top:-80px;right:-75px;background:#0369a1;opacity:.1"></div>
  <div class="blob" style="width:200px;height:200px;bottom:-55px;left:-35px;background:#1e3a5f;opacity:.08;animation-delay:7s"></div>
  <div class="content">
    <div class="reveal label" style="color:var(--muted);margin-bottom:.28rem">Investment Case</div>
    <h2 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.35rem,2.6vw,1.9rem);font-weight:700;margin-bottom:.2rem">The <span style="color:#38bdf8">NOO investment flow.</span> How capital moves.</h2>
    <p class="reveal" style="font-size:.79rem;color:#94a3b8;line-height:1.55;margin-bottom:.55rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Lock in cash flow at the asset level, remove operational variance, and hold through the cycle.</p>
    <div class="reveal flow-row">
      <div class="flow-box">Capital<br><span style="font-size:.63rem;font-weight:400;color:#64748b">Equity + Debt</span></div>
      <div class="flow-arrow">→</div>
      <div class="flow-box highlight">Vessel<br><span style="font-size:.63rem;font-weight:400;color:rgba(56,189,248,.7)">The asset</span></div>
      <div class="flow-arrow">→</div>
      <div class="flow-box">Time Charter<br><span style="font-size:.63rem;font-weight:400;color:#64748b">To carrier</span></div>
      <div class="flow-arrow">→</div>
      <div class="flow-box flow-green">Daily Hire<br><span style="font-size:.63rem;font-weight:400;color:rgba(74,222,128,.65)">Fixed income</span></div>
      <div class="flow-arrow">→</div>
      <div class="flow-box">Debt service<br><span style="font-size:.63rem;font-weight:400;color:#64748b">+ equity return</span></div>
    </div>
    <div class="reveal attr-row">
      <div class="attr-col">
        <div class="label" style="color:#4ade80;margin-bottom:.5rem">What makes it attractive</div>
        <div class="attr-item"><span class="attr-icon" style="color:#4ade80">✓</span><span><strong style="color:#f1f5f9">Predictable cash flow.</strong> Fixed charter rates decouple income from spot freight volatility.</span></div>
        <div class="attr-item"><span class="attr-icon" style="color:#4ade80">✓</span><span><strong style="color:#f1f5f9">No operational exposure.</strong> Fuel, crew, port costs stay with the charterer.</span></div>
        <div class="attr-item"><span class="attr-icon" style="color:#4ade80">✓</span><span><strong style="color:#f1f5f9">Asset-backed returns.</strong> The vessel is hard collateral with a residual value floor.</span></div>
        <div class="attr-item"><span class="attr-icon" style="color:#4ade80">✓</span><span><strong style="color:#f1f5f9">Works as infrastructure.</strong> Long duration, low day-to-day complexity.</span></div>
      </div>
      <div class="attr-divider"></div>
      <div class="attr-col">
        <div class="label" style="color:#f87171;margin-bottom:.5rem">The structural risks</div>
        <div class="attr-item"><span class="attr-icon" style="color:#f87171">△</span><span><strong style="color:#f1f5f9">Asset value is cyclical.</strong> In down markets, vessel prices fall and can erode equity even with cash flow intact.</span></div>
        <div class="attr-item"><span class="attr-icon" style="color:#f87171">△</span><span><strong style="color:#f1f5f9">Refinancing risk.</strong> At charter expiry, re-chartering rates may not cover debt service.</span></div>
        <div class="attr-item"><span class="attr-icon" style="color:#f87171">△</span><span><strong style="color:#f1f5f9">The model shines in bull years.</strong> High charter rates + rising asset values create the full return. Timing matters.</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ SLIDE 4 · WHY CARRIERS CHARTER ═══ -->
<div class="slide" data-slide="4">
  <div class="blob" style="width:340px;height:340px;top:-80px;right:-75px;background:#1e3a5f;opacity:.1"></div>
  <div class="blob" style="width:200px;height:200px;bottom:-55px;left:-35px;background:#0369a1;opacity:.08;animation-delay:4s"></div>
  <div class="content">
    <div class="reveal label" style="color:var(--muted);margin-bottom:.28rem">Why the system works</div>
    <h2 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.35rem,2.6vw,1.9rem);font-weight:700;margin-bottom:.25rem">Why don't carriers just <span style="color:#38bdf8">own their entire fleet?</span></h2>
    <p class="reveal" style="font-size:.79rem;color:#94a3b8;line-height:1.55;margin-bottom:.8rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">Owning ships is expensive, rigid, and ties up capital that operators prefer to deploy elsewhere. Chartering solves all three.</p>
    <div class="three-col">
      <div class="reveal reason-card">
        <div class="reason-num">01</div>
        <div class="reason-title">Capital efficiency</div>
        <div class="reason-body">A new 15,000 TEU containership costs $180–220m. Chartering converts capex into a fixed opex line. MSC and Maersk preserve equity for network investment, M&A, and technology.</div>
      </div>
      <div class="reveal reason-card">
        <div class="reason-num">02</div>
        <div class="reason-title">Fleet flexibility</div>
        <div class="reason-body">Demand cycles. Charter agreements let operators scale up in growth periods and hand back tonnage in downturns. Ownership is permanent — charters expire.</div>
      </div>
      <div class="reveal reason-card">
        <div class="reason-num">03</div>
        <div class="reason-title">Balance sheet management</div>
        <div class="reason-body">Off-balance sheet structures improve leverage ratios and credit profiles. For listed carriers, this has direct impact on cost of capital and shareholder returns.</div>
      </div>
    </div>
    <div class="reveal" style="margin-top:.8rem;padding:.7rem .95rem;border-radius:10px;background:rgba(56,189,248,.05);border:1px solid rgba(56,189,248,.12)">
      <div style="font-size:.76rem;color:#e2e8f0;line-height:1.6">The NOO is not a passive bystander. <strong style="color:#38bdf8">Without the NOO market, carriers would need to own more of what they operate — raising barriers to entry and concentrating risk at the operating level.</strong> The NOO system is structural, not incidental.</div>
    </div>
  </div>
</div>

<!-- ═══ SLIDE 5 · BALANCE OF INTERESTS ═══ -->
<div class="slide" data-slide="5">
  <div class="blob" style="width:340px;height:340px;top:-80px;right:-75px;background:#0369a1;opacity:.1"></div>
  <div class="blob" style="width:200px;height:200px;bottom:-55px;left:-40px;background:#1e3a5f;opacity:.08;animation-delay:5s"></div>
  <div class="content">
    <div class="reveal label" style="color:var(--muted);margin-bottom:.28rem">The Structure</div>
    <h2 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.35rem,2.6vw,1.9rem);font-weight:700;margin-bottom:.2rem">Who gets what — and <span style="color:#38bdf8">who carries what risk.</span></h2>
    <p class="reveal" style="font-size:.79rem;color:#94a3b8;line-height:1.55;margin-bottom:.65rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">A time charter is a negotiated division of upside and exposure. Terms define whether the NOO or charterer holds the stronger position.</p>

    <div class="reveal balance-grid">
      <!-- Owner side -->
      <div class="balance-side">
        <div style="font-size:.64rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#4ade80;margin-bottom:.3rem">NOO · Owner</div>
        <div class="bal-item bal-item-pos-g">Fixed daily hire — income is contractual, not market-dependent.</div>
        <div class="bal-item bal-item-pos-g">Asset appreciation if vessel values rise over the hold period.</div>
        <div class="bal-item bal-item-pos-g">No exposure to fuel, port fees, or crewing costs.</div>
        <!-- Unified risk block -->
        <div class="risk-block" style="margin-top:.5rem">
          <div class="risk-block-title">Owner risks</div>
          <div class="risk-line">Asset devaluation in down cycles erodes equity even with cash flow.</div>
          <div class="risk-line">Charterer default or financial stress can break the income stream.</div>
        </div>
      </div>

      <!-- Center divider -->
      <div class="balance-center">
        <div style="width:1px;height:100%;background:linear-gradient(to bottom,transparent,rgba(56,189,248,.22),rgba(56,189,248,.22),transparent);margin:0 auto"></div>
      </div>

      <!-- Charterer side -->
      <div class="balance-side">
        <div style="font-size:.64rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#38bdf8;margin-bottom:.3rem">Carrier · Charterer</div>
        <div class="bal-item bal-item-pos-b">Fleet flexibility — return tonnage at charter expiry, no residual liability.</div>
        <div class="bal-item bal-item-pos-b">Capital freed for network, technology, and market share investment.</div>
        <div class="bal-item bal-item-pos-b">Upside on freight rates flows entirely to the carrier's P&L.</div>
        <!-- Unified risk block -->
        <div class="risk-block" style="margin-top:.5rem">
          <div class="risk-block-title">Charterer risks</div>
          <div class="risk-line">Locked into fixed hire even when freight markets collapse.</div>
          <div class="risk-line">No asset ownership means no hedge on vessel scarcity.</div>
        </div>
      </div>
    </div>
  </div>
</div>

</div><!-- /deck -->
<div class="nav-controls">
  <button class="nav-btn" onclick="changeSlide(-1)">&#8249;</button>
  <div style="display:flex;gap:7px" id="dots"></div>
  <button class="nav-btn" onclick="changeSlide(1)">&#8250;</button>
  <span class="slide-counter" id="counter">1 / 5</span>
</div>
