.thesis-line{font-family:"Playfair Display",serif;font-size:clamp(1.05rem,1.9vw,1.45rem);font-weight:700;line-height:1.55;color:#e2e8f0;border-left:2px solid var(--slate);padding-left:1rem;margin-bottom:.85rem}
