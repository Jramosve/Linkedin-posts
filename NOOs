<script>
let cur=1;
const slides=document.querySelectorAll('.slide');
const tot=slides.length;
const dc=document.getElementById('dots');
const ct=document.getElementById('counter');
for(let i=1;i<=tot;i++){const d=document.createElement('div');d.className='dot'+(i===1?' active':'');d.onclick=()=>go(i);dc.appendChild(d)}
function go(n){
  document.querySelector('.slide.active').classList.remove('active');
  document.querySelector('.slide[data-slide="'+n+'"]').classList.add('active');
  cur=n;
  document.querySelectorAll('.dot').forEach((d,i)=>d.classList.toggle('active',i+1===cur));
  ct.textContent=cur+' / '+tot;
  anim(document.querySelector('.slide.active'));
}
function changeSlide(d){let n=cur+d;if(n<1)n=tot;if(n>tot)n=1;go(n)}
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key===' '){e.preventDefault();changeSlide(1)}
  if(e.key==='ArrowLeft'){e.preventDefault();changeSlide(-1)}
});
let tx=0;
document.addEventListener('touchstart',e=>tx=e.touches[0].clientX);
document.addEventListener('touchend',e=>{const d=tx-e.changedTouches[0].clientX;if(Math.abs(d)>50)changeSlide(d>0?1:-1)});
function anim(slide){
  slide.querySelectorAll('.reveal').forEach((el,i)=>{
    el.style.transition='none';el.style.opacity='0';el.style.transform='translateY(14px)';
    el.offsetHeight;
    el.style.transition='opacity .32s ease '+(i*.07)+'s,transform .32s ease '+(i*.07)+'s';
    el.style.opacity='1';el.style.transform='translateY(0)';
  });
  setTimeout(()=>{
    slide.querySelectorAll('.bar-fill').forEach(b=>{b.style.width=(b.dataset.width||'0')+'%';});
  },400);
}
anim(document.querySelector('.slide.active'));
</script>
