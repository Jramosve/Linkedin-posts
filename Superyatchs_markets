        .lc-b{font-size:0.65rem;color:#334155;line-height:1.38;}
        .map-footer{display:flex;justify-content:space-between;align-items:center;padding-top:0.32rem;border-top:1px solid rgba(255,255,255,0.04);}
    </style>
