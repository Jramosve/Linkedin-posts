        .nav-btn:hover{background:rgba(14,165,233,0.18);}
        .dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,0.12);cursor:pointer;transition:all 0.3s;}
        .dot.active{background:var(--slate);transform:scale(1.4);}
        .slide-counter{font-size:0.68rem;color:var(--muted);min-width:32px;text-align:center;}
        .author-tag{position:fixed;bottom:20px;right:26px;z-index:300;font-size:0.63rem;font-weight:600;letter-spacing:0.05em;color:rgba(148,163,184,0.35);pointer-events:none;}

        /* UTILS */
        .label{font-size:0.6rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;}
        .pill{font-size:0.58rem;font-weight:700;padding:2px 8px;border-radius:4px;}
        .p-pos{background:rgba(74,222,128,0.12);color:#4ade80;}
        .p-neg{background:rgba(248,113,113,0.12);color:#f87171;}
        .p-neu{background:rgba(245,158,11,0.12);color:#f59e0b;}
        .p-blue{background:rgba(56,189,248,0.12);color:#38bdf8;}
        .row{display:flex;justify-content:space-between;align-items:center;padding:0.34rem 0;border-bottom:1px solid rgba(255,255,255,0.05);}
        .row:last-child{border-bottom:none;}

        /* MAP SLIDE LAYOUT */
        .map-layout{display:grid;grid-template-rows:auto 1fr auto auto;height:100vh;padding:1.4rem 2rem 0.85rem;gap:0.55rem;}
        #map{width:100%;height:100%;border-radius:12px;border:1px solid rgba(255,255,255,0.07);overflow:hidden;}
        .leaflet-container{background:#060d1a!important;cursor:default!important;}
        .leaflet-grab,.leaflet-grabbing{cursor:default!important;}
        .leaflet-interactive{cursor:pointer!important;}
        .leaflet-control-zoom,.leaflet-control-attribution{display:none!important;}
        .leaflet-popup-content-wrapper{background:rgba(5,9,20,0.97)!important;border:1px solid rgba(255,255,255,0.09)!important;border-radius:10px!important;box-shadow:0 16px 48px rgba(0,0,0,0.8)!important;backdrop-filter:blur(18px);}
        .leaflet-popup-tip-container{display:none!important;}
        .leaflet-popup-content{margin:0!important;padding:0!important;}
        .pi{padding:0.85rem 1rem;min-width:220px;}
        .pt{font-size:0.8rem;font-weight:700;margin-bottom:0.12rem;}
        .ps{font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:#1e3a5f;margin-bottom:0.5rem;}
        .pr{display:flex;justify-content:space-between;gap:1rem;padding:0.2rem 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:0.69rem;}
        .pr:last-of-type{border:none;}
        .pr span:first-child{color:#334155;}
        .pr span:last-child{font-weight:600;color:#e2e8f0;}
        .pp{display:inline-block;margin-top:0.42rem;padding:2px 8px;border-radius:4px;font-size:0.57rem;font-weight:700;}
        .leaflet-popup-close-button{color:#1e3a5f!important;font-size:1rem!important;top:5px!important;right:7px!important;}
        @keyframes pring{0%{transform:translate(-50%,-50%) scale(1);opacity:0.7}100%{transform:translate(-50%,-50%) scale(3.2);opacity:0}}
        .legend-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0.55rem;}
        .lc{border-radius:8px;padding:0.48rem 0.72rem;border:1px solid;}
