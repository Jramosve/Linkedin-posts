        html,body{background:var(--bg);height:100vh;width:100vw;overflow:hidden;font-family:"DM Sans",sans-serif;color:var(--text);}

        /* DECK */
        .deck{width:100vw;height:100vh;position:relative;}
        .slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(0.97);transition:opacity 0.5s ease,transform 0.5s ease;pointer-events:none;overflow:hidden;}
