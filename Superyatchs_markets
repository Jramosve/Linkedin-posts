<!-- ══ SLIDE 5: SOUTHEAST ASIA ══ -->
<div class="slide" data-slide="5">
    <div class="blob" style="width:360px;height:360px;top:-80px;right:-70px;background:#064e3b;opacity:0.15;"></div>
    <div class="content">
        <div class="reveal label" style="color:var(--muted);margin-bottom:0.3rem;">Investment Thesis</div>
        <h2 class="reveal" style="font-family:'Playfair Display',serif;font-size:clamp(1.4rem,2.8vw,2rem);font-weight:700;margin-bottom:1rem;">Southeast Asia: <span style="color:#4ade80;">The Underdeveloped Frontier.</span></h2>
        <div style="display:grid;grid-template-columns:1.1fr 0.9fr;gap:1rem;">
            <div>
                <p class="reveal" style="font-size:0.83rem;color:#94a3b8;line-height:1.7;margin-bottom:0.85rem;">Southeast Asia presents what is arguably the most asymmetric opportunity in global marina investment today. The region attracted 140 million air passengers in 2024. Thailand alone received 35 million international visitors, making it a top-ten global aviation destination. Vietnam, Cambodia, and the wider Indochina corridor are growing at comparable rates. The demand signal for high-end coastal tourism is unambiguous.</p>
                <p class="reveal" style="font-size:0.83rem;color:#94a3b8;line-height:1.7;margin-bottom:0.85rem;">The supply side tells a different story. Thailand has fewer than 2,000 quality berths nationally, concentrated in Phuket across three facilities. Vietnam is committing VND 7,260 billion to 38 yachting projects including two international marinas in Da Nang. Cambodia has no meaningful marina infrastructure. The structural gap between tourism demand and marine infrastructure is among the largest of any high-growth market in the world.</p>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.6rem;">
                    <div style="background:rgba(74,222,128,0.06);border:1px solid rgba(74,222,128,0.18);border-radius:8px;padding:0.65rem;">
                        <div class="label" style="color:#4ade80;margin-bottom:0.25rem;">Thailand</div>
                        <div style="font-size:1.3rem;font-weight:800;">&lt;2,000</div>
                        <div style="font-size:0.63rem;color:#475569;">quality berths nationally</div>
                        <div style="margin-top:0.35rem;font-size:0.68rem;color:#94a3b8;">35m intl. visitors 2024.</div>
                    </div>
                    <div style="background:rgba(74,222,128,0.06);border:1px solid rgba(74,222,128,0.18);border-radius:8px;padding:0.65rem;">
                        <div class="label" style="color:#4ade80;margin-bottom:0.25rem;">Vietnam</div>
                        <div style="font-size:1.3rem;font-weight:800;">VND 7.26tn</div>
                        <div style="font-size:0.63rem;color:#475569;">38 yacht projects committed</div>
                        <div style="margin-top:0.35rem;font-size:0.68rem;color:#94a3b8;">Da Nang · Phu Quoc emerging.</div>
                    </div>
                    <div style="background:rgba(74,222,128,0.04);border:1px solid rgba(74,222,128,0.12);border-radius:8px;padding:0.65rem;">
                        <div class="label" style="color:#4ade80;margin-bottom:0.25rem;">Cambodia</div>
                        <div style="font-size:1.3rem;font-weight:800;">Nascent</div>
                        <div style="font-size:0.63rem;color:#475569;">no intl. infrastructure</div>
                        <div style="margin-top:0.35rem;font-size:0.68rem;color:#94a3b8;">TH–KH–VN route in planning.</div>
                    </div>
                    <div style="background:rgba(74,222,128,0.04);border:1px solid rgba(74,222,128,0.12);border-radius:8px;padding:0.65rem;">
                        <div class="label" style="color:#4ade80;margin-bottom:0.25rem;">Season</div>
                        <div style="font-size:1.3rem;font-weight:800;color:#4ade80;">Nov–Apr</div>
                        <div style="font-size:0.63rem;color:#475569;">dry season · perfect overlap</div>
                        <div style="margin-top:0.35rem;font-size:0.68rem;color:#94a3b8;">Mirrors GCC and Caribbean.</div>
                    </div>
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.7rem;">
                <div style="background:rgba(255,255,255,0.025);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:1rem;">
                    <div class="label" style="color:#4ade80;margin-bottom:0.55rem;">The Investment Case</div>
                    <div style="display:flex;flex-direction:column;gap:0.45rem;">
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#4ade80;font-size:0.78rem;">✓</span><span style="font-size:0.77rem;color:#94a3b8;">Proven aviation-driven tourism demand, no need to create the market</span></div>
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#4ade80;font-size:0.78rem;">✓</span><span style="font-size:0.77rem;color:#94a3b8;">Season complement to Mediterranean, same HNW clientele rotating annually</span></div>
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#4ade80;font-size:0.78rem;">✓</span><span style="font-size:0.77rem;color:#94a3b8;">Low competition, first mover economics still available in Vietnam and Cambodia</span></div>
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#4ade80;font-size:0.78rem;">✓</span><span style="font-size:0.77rem;color:#94a3b8;">Government-backed development programs providing land and regulatory clarity</span></div>
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#f87171;font-size:0.78rem;">△</span><span style="font-size:0.77rem;color:#94a3b8;">Regulatory complexity varies significantly, local partnerships essential</span></div>
                        <div style="display:flex;gap:0.5rem;align-items:flex-start;"><span style="color:#f87171;font-size:0.78rem;">△</span><span style="font-size:0.77rem;color:#94a3b8;">Superyacht draught constraints in some locations require careful site selection</span></div>
                    </div>
                </div>
                <div style="background:rgba(74,222,128,0.06);border:1px solid rgba(74,222,128,0.2);border-radius:8px;padding:0.9rem;border-left:2px solid #4ade80;">
                    <p style="font-size:0.77rem;color:#94a3b8;line-height:1.6;font-style:italic;">"The Mediterranean created the superyacht industry. The Caribbean extended its season. Southeast Asia has the tourism infrastructure, the coastline, and the season alignment to complete the triangle. The question is not whether the market will develop. It is who builds it first."</p>
                    <p style="font-size:0.63rem;color:#334155;margin-top:0.35rem;">Javier Ramos Velasco · José María Serraclara · 2026</p>
                </div>
            </div>
        </div>
        <div class="reveal" style="margin-top:0.4rem;font-size:0.58rem;color:#1e293b;text-align:center;">Sources: Nation Thailand 2026 · Asia Pacific Boating · Bao Da Nang 2024 · Forbes and Partners · Thai Times 2025</div>
    </div>
</div>

</div><!-- /deck -->

<!-- NAV -->
<div class="nav-controls">
    <button class="nav-btn" onclick="changeSlide(-1)">&#8249;</button>
    <div style="display:flex;gap:8px;" id="dots"></div>
    <button class="nav-btn" onclick="changeSlide(1)">&#8250;</button>
    <span class="slide-counter" id="counter">1 / 5</span>
</div>

<script>
// ── NAV ──
let cur=1;
const tot=document.querySelectorAll(".slide").length;
const dc=document.getElementById("dots");
const ct=document.getElementById("counter");
for(let i=1;i<=tot;i++){const d=document.createElement("div");d.className="dot"+(i===1?" active":"");d.onclick=()=>go(i);dc.appendChild(d);}
function go(n){
    document.querySelector(".slide.active").classList.remove("active");
    document.querySelector(`.slide[data-slide="${n}"]`).classList.add("active");
    cur=n;
    document.querySelectorAll(".dot").forEach((d,i)=>d.classList.toggle("active",i+1===cur));
    ct.textContent=cur+" / "+tot;
    anim(document.querySelector(".slide.active"));
    if(n===2&&!window._mapInited) initMap();
}
function changeSlide(d){let n=cur+d;if(n<1)n=tot;if(n>tot)n=1;go(n);}
document.addEventListener("keydown",e=>{if(e.key==="ArrowRight"||e.key===" "){e.preventDefault();changeSlide(1);}if(e.key==="ArrowLeft"){e.preventDefault();changeSlide(-1);}});
let tx=0;
document.addEventListener("touchstart",e=>tx=e.touches[0].clientX);
document.addEventListener("touchend",e=>{const d=tx-e.changedTouches[0].clientX;if(Math.abs(d)>50)changeSlide(d>0?1:-1);});
function anim(slide){slide.querySelectorAll(".reveal").forEach((el,i)=>{el.style.transition="none";el.style.opacity="0";el.style.transform="translateY(14px)";el.offsetHeight;el.style.transition=`opacity 0.32s ease ${i*0.07}s,transform 0.32s ease ${i*0.07}s`;el.style.opacity="1";el.style.transform="translateY(0)";});}
try{anim(document.querySelector(".slide.active"));}catch(e){}

// ── MAP (lazy init when slide 2 is opened) ──
function initMap(){
    window._mapInited=true;
    const map=L.map("map",{center:[20,35],zoom:2,zoomControl:false,attributionControl:false,dragging:false,touchZoom:false,doubleClickZoom:false,scrollWheelZoom:false,boxZoom:false,keyboard:false});
    L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_nolabels/{z}/{x}/{y}{r}.png",{subdomains:"abcd",maxZoom:8}).addTo(map);
    L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_only_labels/{z}/{x}/{y}{r}.png",{subdomains:"abcd",maxZoom:8,opacity:0.4}).addTo(map);

    const zs=(color)=>({color,weight:1.5,opacity:0.7,fillColor:color,fillOpacity:0.13,dashArray:"5 5"});
    L.polygon([[30,-6],[30,36],[42,36],[46,18],[44,8],[38,-6]],zs("#f59e0b")).addTo(map);
    L.polygon([[9,-85],[9,-60],[24,-60],[26,-75],[22,-88],[14,-90]],zs("#f59e0b")).addTo(map);
    L.polygon([[12,40],[12,60],[26,60],[30,50],[28,38],[20,38]],zs("#f87171")).addTo(map);
    L.polygon([[0,98],[0,122],[22,122],[24,100],[16,96],[5,96]],zs("#4ade80")).addTo(map);
    L.polygon([[-5,68],[-5,80],[8,80],[8,68]],{color:"#a78bfa",weight:1,opacity:0.45,fillColor:"#a78bfa",fillOpacity:0.09,dashArray:"3 5"}).addTo(map);
    L.polygon([[30,22],[30,36],[42,36],[42,22]],{color:"#a78bfa",weight:1,opacity:0.35,fillColor:"#a78bfa",fillOpacity:0.06,dashArray:"3 5"}).addTo(map);

    function pm(latlng,color,size=16){
        const s=size,s2=s*2;
        return L.marker(latlng,{icon:L.divIcon({className:"",iconSize:[s2,s2],iconAnchor:[s,s],html:`<div style="position:relative;width:${s2}px;height:${s2}px;"><div style="position:absolute;top:50%;left:50%;width:${s}px;height:${s}px;border-radius:50%;background:${color};opacity:0.2;transform:translate(-50%,-50%);animation:pring 2s ease-out infinite;"></div><div style="position:absolute;top:50%;left:50%;width:${s*0.62}px;height:${s*0.62}px;border-radius:50%;background:${color};border:2px solid rgba(255,255,255,0.22);transform:translate(-50%,-50%);box-shadow:0 0 ${s}px ${color}55;"></div></div>`})});
    }
    function pop(title,sub,rows,pill,color){
        const r=rows.map(x=>`<div class="pr"><span>${x[0]}</span><span>${x[1]}</span></div>`).join("");
        return `<div class="pi"><div class="pt" style="color:${color};">${title}</div><div class="ps">${sub}</div>${r}<div><span class="pp" style="background:${color}22;color:${color};">${pill}</span></div></div>`;
    }
    const po={maxWidth:255,autoPanPadding:[16,16]};

    pm([37,13],"#f59e0b",18).addTo(map).bindPopup(pop("Mediterranean","TRADITIONAL · SATURATED",[["Berths 24m+","4,500–4,800"],["Fleet at peak","5,000+ yachts"],["Supply growth/yr","< 1%"],["Season","Jun – Oct"]],"STRUCTURALLY UNDERSUPPLIED","#f59e0b"),po);
    pm([15.5,-66],"#f59e0b",14).addTo(map).bindPopup(pop("Caribbean","TRADITIONAL · CONSOLIDATING",[["Key hubs","Antigua · BVI · St Martin"],["Season","Nov – Apr"],["Investment trend","M&A consolidation"],["New berths","Minimal"]],"MATURING MARKET","#f59e0b"),po);
    pm([25.2,55.3],"#f87171",18).addTo(map).bindPopup(pop("UAE · Dubai & Abu Dhabi","GCC · DISRUPTED FRONTRUNNER",[["Superyachts 30m+","321 · 5.1% global"],["Season","Oct – Apr"],["Insurance surge","+60%"],["GCC contracts YoY","–40% in 2025"]],"GEOPOLITICAL RISK · REPRICING","#f87171"),po);
    pm([22.5,59.5],"#f87171",11).addTo(map).bindPopup(pop("Oman","GCC · ACTIVE PIPELINE",[["Salalah marina","USD 104m · NMDC 2025"],["Quriyat marina","Tender open 2025"],["Total pipeline","USD 150m+"]],"ACTIVE DESPITE HEADWINDS","#f87171"),po);
    pm([24.5,46.7],"#f87171",11).addTo(map).bindPopup(pop("Saudi Arabia","GCC · VISION 2030",[["NEOM marina","In development"],["Red Sea Project","Luxury coastal tourism"],["Hormuz exposure","Direct risk"]],"LONG-TERM VISION","#f87171"),po);
    pm([7.9,98.3],"#4ade80",18).addTo(map).bindPopup(pop("Thailand · Phuket","SOUTHEAST ASIA · FRONTIER",[["Quality berths","< 2,000 nationally"],["Facilities","Royal Phuket · Yacht Haven · Ao Po"],["Intl. visitors 2024","35 million"],["Season","Nov – Apr"]],"HIGHEST POTENTIAL · FIRST MOVER","#4ade80"),po);
    pm([16.1,108.2],"#4ade80",13).addTo(map).bindPopup(pop("Vietnam · Da Nang & Phu Quoc","SOUTHEAST ASIA · EARLY STAGE",[["Govt. commitment","VND 7,260bn · 38 projects"],["Intl. marinas","2 planned · Da Nang"],["Season","Nov – Apr"]],"EARLY STAGE · HIGH UPSIDE","#4ade80"),po);
    pm([10.6,103.8],"#4ade80",11).addTo(map).bindPopup(pop("Cambodia · Sihanoukville","SOUTHEAST ASIA · NASCENT",[["Intl. marinas","None existing"],["Developing","Kep · Kampot · Sihanoukville"],["Season","Nov – Apr"]],"NASCENT · LONG TERM","#4ade80"),po);
    pm([4.2,73.5],"#a78bfa",11).addTo(map).bindPopup(pop("Maldives","INDIAN OCEAN · NICHE",[["Demand tier","Ultra-premium"],["Infrastructure gap","Significant"],["Complexity","High regulatory"]],"NICHE · SPECIALIST ONLY","#a78bfa"),po);
    pm([37.5,26],"#a78bfa",11).addTo(map).bindPopup(pop("East Med · Greece & Turkey","WATCHLIST · WITHIN MED ECOSYSTEM",[["Investment","Capacity expansion"],["Risk","Low · EU / NATO"],["Season","Jun – Oct"]],"MEDIUM TERM · LOWER UPSIDE","#a78bfa"),po);
}
</script>
