<!-- ══ SLIDE 2: MAP ══ -->
<div class="slide" data-slide="2" style="padding:0;align-items:stretch;">
    <div class="map-layout" style="width:100%;position:relative;z-index:2;">
        <div>
            <div class="label" style="color:var(--muted);margin-bottom:0.18rem;">Global Market Landscape · Marina Investment 2026</div>
            <h2 style="font-family:'Playfair Display',serif;font-size:clamp(1.1rem,2.2vw,1.65rem);font-weight:700;line-height:1.15;">Where Superyachts Go. <span style="color:#38bdf8;">And Where They Cannot Fit.</span></h2>
